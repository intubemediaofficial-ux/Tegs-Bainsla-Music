# ---- Auth ----
# Long random string used to sign JWT session tokens. REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Seed admin account (created on first run / `npm run seed`)
ADMIN_EMAIL=admin@bainslamusic.com
ADMIN_PASSWORD=change-me

# ---- Storage ----
# Storage driver: "file" (default, JSON on disk) or "kv" (Upstash / Vercel KV REST)
STORAGE_DRIVER=file
# Required only when STORAGE_DRIVER=kv (Upstash Redis REST creds):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Trending cron ----
# Secret required to call /api/cron/refresh (set the same value in the Vercel Cron header)
CRON_SECRET=change-me

# ---- Optional: exact metrics ----
# YouTube Data API v3 key. Optional. When set, ranking/search accuracy improves.
YOUTUBE_API_KEY=
