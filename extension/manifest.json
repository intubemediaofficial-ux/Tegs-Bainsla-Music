{
  "manifest_version": 3,
  "name": "Bainsla Music Tags — YouTube Tag, Title & Trend Studio",
  "version": "1.4.1",
  "description": "Ranked tags, real ranking titles, hashtags and live 60-min/48-hour view pulse for the YouTube video you are watching.",
  "action": {
    "default_title": "Bainsla Music Tags",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    { "resources": ["icons/icon48.png"], "matches": ["*://*.youtube.com/*"] }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["*://*.youtube.com/*", "https://tag.bainslamusic.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://tag.bainslamusic.com/*", "http://localhost/*"],
      "js": ["content/connect.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://studio.youtube.com/*"],
      "js": ["content/shared.js", "content/studio.js"],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content/shared.js", "content/watch.js", "content/pulse.js"],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
